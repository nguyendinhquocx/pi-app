{
  "manifest_version": 3,
  "name": "LiX Browser Bridge",
  "description": "Lets the AI in LiX work in this Chrome (your sign-ins) in its own window. Pair it from LiX → Settings → Browser.",
  "version": "1.1.0",
  "minimum_chrome_version": "125",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "downloads",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LiX",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  }
}
