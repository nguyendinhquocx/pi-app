# li.quoc.app — Cloudflare Pages headers (spec T3)
# CSP ở đây là authoritative (frame-ancestors chỉ hiệu lực qua header); meta CSP trong
# index.html là fallback khi hosting không áp file này.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self' wss://*.ts.net; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
